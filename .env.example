# ==========================================================================
# Hermes — configuração do motor (engine + worker)
# Copie para .env e preencha. Em produção (Render), cadastre estes mesmos
# valores em Environment, nunca no repositório.
# ==========================================================================

PORT=3001
NODE_ENV=development

# Deriva a chave AES do cofre. Use 32+ caracteres aleatórios.
# ATENÇÃO: se este valor mudar, todas as credenciais salvas ficam ilegíveis
# e as redes precisam ser reconectadas.
ENCRYPTION_KEY=

# --- Acesso ao motor ------------------------------------------------------
# E-mails (ou UIDs) do Firebase Auth autorizados a operar, separados por vírgula.
# Sem isto preenchido, as rotas autenticadas recusam tudo.
ALLOWED_OPERATORS=

# Origens do navegador que podem chamar o motor (a dashboard)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Opcional: aceita também os previews https://<prefixo>-*.vercel.app
VERCEL_PREVIEW_PREFIX=

# URL pública do motor — monta o redirect URI do OAuth e o link do vídeo.
# Precisa ser HTTPS para o Instagram conseguir baixar o MP4.
ENGINE_PUBLIC_URL=http://localhost:3001
# Para onde o callback do OAuth devolve o operador
DASHBOARD_URL=http://localhost:3000

# --- Esteira de produção --------------------------------------------------
# true = a API roda o worker no mesmo processo (necessário em planos free que
# não oferecem serviço de background worker). false = use "npm run worker".
ENABLE_WORKER=false

# Onde escrever os arquivos. Em hosts com disco efêmero, aponte para /tmp.
OUTPUT_DIR=
TEMP_DIR=

# Como o Instagram obtém uma URL HTTPS do vídeo:
#   engine  = o próprio motor serve o arquivo (gratuito)
#   storage = Firebase Cloud Storage (exige o plano Blaze, pago)
PUBLIC_VIDEO_STRATEGY=engine

# --- IA e mídia -----------------------------------------------------------
GEMINI_API_KEY=
# Opcional: sem ela o vídeo sai com fundo sólido em vez de clipes
PEXELS_API_KEY=

# --- Firebase Admin -------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Só necessário com PUBLIC_VIDEO_STRATEGY=storage
FIREBASE_STORAGE_BUCKET=

# --- App padrão das redes (opcional) --------------------------------------
# Identificam o Hermes perante a plataforma, não uma conta. Servem de fallback
# para canais que ainda não cadastraram o próprio app na dashboard.
# Para vários canais publicando em paralelo, prefira um app por canal: a cota do
# YouTube é cobrada por projeto do Google Cloud.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
