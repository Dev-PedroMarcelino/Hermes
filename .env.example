# Hermes Core Configuration
PORT=
NODE_ENV=
ENCRYPTION_KEY=

# AI & Media API Keys
GEMINI_API_KEY=
PEXELS_API_KEY=

# Firebase Admin Credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Engine API protection (dashboard must send this as x-api-key)
ENGINE_API_KEY=
# Comma-separated allowed CORS origins for the dashboard
ALLOWED_ORIGINS=
# Public base URL of the engine (used to build OAuth redirect URIs)
ENGINE_PUBLIC_URL=
# Where to send the user back in the dashboard after an OAuth callback
DASHBOARD_URL=

# App padrão do sistema (opcional) — fallback para canais sem app próprio.
# --- YouTube Data API v3 (Google Cloud Console) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok for Developers ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Meta / Instagram Graph API ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
