# URL do motor Hermes (engine)
VITE_ENGINE_URL=http://localhost:3001
# Nao existe mais chave de API aqui: o acesso e autenticado por Firebase Auth.
# Crie o usuario em Firebase Console > Authentication e liste o e-mail em
# ALLOWED_OPERATORS no .env do motor.

# Firebase Web SDK (Console do Firebase > Configurações do projeto > Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hermes-ca93c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hermes-ca93c
VITE_FIREBASE_STORAGE_BUCKET=hermes-ca93c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
